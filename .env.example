# Copy to .env. Settings are read only by aworker.config.Settings.
AWORKER_LAB_HOST=127.0.0.1
AWORKER_LAB_PORT=4173
AWORKER_LAB_DEFAULT_OPERATOR=ConfusionMulGrad
# No SSH / NPU needed. Real independent simulation requires a separate Linux/CANN Worker.
AWORKER_LAB_EXECUTION_MODE=judge-only
AWORKER_LAB_TEAM_CONCURRENCY=4
AWORKER_LAB_MAX_STEPS=400
AWORKER_LAB_AGENT_TIMEOUT=3600
# Independent Linux/CANN simulator queue; separate from model concurrency.
AWORKER_LAB_SIMULATOR_CONCURRENCY=1
AWORKER_LAB_REQUIRE_SIMULATION=true
# Official browser login is owned by this project. Only the human signs in.
# Windows auto-detects Chrome / Edge; other platforms use installed Playwright Chromium.
# AWORKER_LAB_JUDGE_BROWSER_CHANNEL=chrome
AWORKER_LAB_JUDGE_SUBMIT_INTERVAL=60
# Models / servers can also be configured in the dashboard.
# AWORKER_LAB_PRIVATE_ROOT=/path/to/local/private/JustKernel/workbench
# Standard API keys; omit providers you do not use.
# AWORKER_LAB_PROVIDER_KEYS={"openai":"YOUR_KEY","glm":"YOUR_KEY","deepseek":"YOUR_KEY"}
# AWORKER_LAB_PROXY_URL=http://127.0.0.1:7890
# Existing SSH Host alias. Keep passwords/private keys in your SSH configuration.
# AWORKER_LAB_SSH_HOST=ascend-lab
# AWORKER_LAB_SSH_OPTIONS=["-F","C:/path/to/ssh/config"]
# AWORKER_LAB_CANN_ENV=/home/developer/Ascend/cann-9.0.0/set_env.sh
# AWORKER_LAB_REMOTE_ROOT=/mnt/workspace/justkernel-lab
# AWORKER_LAB_DEVICE=0
AWORKER_LAB_MAX_ACTIVE=8
AWORKER_LAB_MAX_EVALUATIONS=2
# Opt in to sending graph inputs/outputs to your LangSmith account.
AWORKER_LAB_LANGSMITH_ENABLED=false
# AWORKER_LAB_LANGSMITH_API_KEY=YOUR_KEY
# AWORKER_LAB_LANGSMITH_PROJECT=JustKernel
