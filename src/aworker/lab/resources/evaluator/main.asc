// Evaluator-owned harness. Candidate submission consists of kernel.asc only.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <vector>
#include "acl/acl.h"

#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"

#define CHECK(expr) do { auto err = (expr); if (err != ACL_SUCCESS) { \
  fprintf(stderr, "ACL failure %s: %d\n", #expr, int(err)); return 2; } } while (0)

bool Read(const char* name, std::vector<uint8_t>& data) {
    std::ifstream file(name, std::ios::binary);
    file.read(reinterpret_cast<char*>(data.data()), data.size());
    return bool(file) && file.peek() == std::ifstream::traits_type::eof();
}

int main(int argc, char** argv) {
    if (argc != 9) return 1;
    const int device = atoi(argv[1]);
    int64_t shape[] = {atoll(argv[2]), atoll(argv[3]), atoll(argv[4]), atoll(argv[5])};
    const int dtype = atoi(argv[6]);
    const float theta = strtof(argv[7], nullptr);
    const int repetitions = atoi(argv[8]);
    size_t count = size_t(shape[0]) * shape[1] * shape[2] * shape[3];
    const size_t bytes = count * (dtype == 0 ? 4 : 2);
    const size_t positionBytes = size_t(shape[0]) * shape[1] * 4;
    std::vector<uint8_t> x(bytes), p(positionBytes), y(bytes);
    if (!Read("x.bin", x) || !Read("positions.bin", p)) return 3;
    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(device));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));
    int64_t cores = 0;
    CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores));
    void *dx = nullptr, *dp = nullptr, *dy = nullptr;
    CHECK(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dp, positionBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(dx, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(dp, positionBytes, p.data(), positionBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemset(dy, bytes, 0xA5, bytes));
    TensorInfo xt{shape, 4, dtype}, yt{shape, 4, dtype};
    int64_t posShape[] = {shape[0], shape[1]};
    TensorInfo pt{posShape, 2, 5};
    TensorGroupInfo ix{&xt, 1}, ip{&pt, 1}, iy{&yt, 1};
    // First call is verified independently of warm-up/timing.
    run_kernel((GM_ADDR)dx, ix, (GM_ADDR)dp, ip, (GM_ADDR)dy, iy, cores, stream, theta);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    CHECK(aclrtMemcpy(y.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream first("first_y.bin", std::ios::binary);
    first.write(reinterpret_cast<const char*>(y.data()), bytes); first.close();
    for (int i = 0; i < 3; ++i)
        run_kernel((GM_ADDR)dx, ix, (GM_ADDR)dp, ip, (GM_ADDR)dy, iy, cores, stream, theta);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    aclrtEvent start, end;
    CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end));
    CHECK(aclrtRecordEvent(start, stream));
    for (int i = 0; i < repetitions; ++i)
        run_kernel((GM_ADDR)dx, ix, (GM_ADDR)dp, ip, (GM_ADDR)dy, iy, cores, stream, theta);
    CHECK(aclrtRecordEvent(end, stream));
    CHECK(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    float ms = 0;
    CHECK(aclrtEventElapsedTime(&ms, start, end));
    CHECK(aclrtMemcpy(y.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream last("last_y.bin", std::ios::binary);
    last.write(reinterpret_cast<const char*>(y.data()), bytes); last.close();
    printf("{\"event_mean_us\":%.6f,\"repetitions\":%d,\"vector_cores\":%lld}\n",
           double(ms) * 1000 / repetitions, repetitions, (long long)cores);
    aclrtDestroyEvent(start); aclrtDestroyEvent(end);
    aclrtFree(dx); aclrtFree(dp); aclrtFree(dy);
    aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
    return 0;
}
